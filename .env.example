# Copy to .env.local for local dev. Set the same three in Vercel for production.
# Start with TEST keys (sk_test_...). Swap to live keys only after a successful
# test checkout. Never commit this file with real values.

STRIPE_SECRET_KEY=sk_test_REPLACE-WITH-YOUR-KEY
STRIPE_WEBHOOK_SECRET=whsec_REPLACE-WITH-YOUR-SECRET
NEXT_PUBLIC_SITE_URL=http://localhost:3000
